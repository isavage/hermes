# ── Doppler secret schema for the Zeno Hermes deployment ─────────────────
# These variables MUST exist in your Doppler project/environment (prod-IN).
# docker-compose.yml interpolates them, and the deploy workflow runs compose
# under `doppler run`, so they are injected at runtime — never committed.
#
# Hermes config.yaml / SOUL.md / skills are managed via the dashboard and live
# in the named Docker volume `hermes-data` (mounted at /opt/data), not in this
# repo.
#
# Copy this file to .env ONLY as a local dev aid. On the VPS, use Doppler:
#   doppler setup          # link the project
#   doppler secrets        # verify they resolve
#   doppler run -- docker compose up -d

# ── Model provider API keys ─────────────────────────────────────────────
# The agent reads these from the environment. Set whichever providers you use.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=                 # Moonshot / Kimi
MOONSHOT_API_KEY=
FIREWORKS_API_KEY=
GOOGLE_API_KEY=               # Gemini / Google AI Studio (aistudio.google.com/app/apikey)
# GEMINI_API_KEY=             # accepted alias for GOOGLE_API_KEY inside Hermes

# ── Telegram (messaging gateway) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=       # comma-separated numeric user IDs
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_HOME_CHANNEL=        # optional chat/channel ID

# ── Container user mapping ──────────────────────────────────────────────
# Hermes runs as a non-root user inside the container. Data lives in the
# named volume `hermes-data` (mounted at /opt/data); on first use Docker
# copies ownership from the image (typically 10000:10000). These vars control
# the in-container user so it matches what the image expects.
HERMES_UID=10000
HERMES_GID=10000

# ── Dashboard ───────────────────────────────────────────────────────────
# Served by the same container as a supervised s6 service (default on).
HERMES_DASHBOARD=1

# ── Dashboard auth (first-run bootstrap) ────────────────────────────────
# The deploy script derives a password hash from these and writes a valid
# config.yaml on first boot, so the dashboard can start with no manual SSH.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Public URL the dashboard advertises in its generated config (optional;
# defaults to https://zeno.varunrs.in).
DASHBOARD_PUBLIC_URL=https://zeno.varunrs.in
